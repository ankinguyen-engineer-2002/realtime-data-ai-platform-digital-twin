# =============================================================================
#  Environment template — copy to platform/env/.env (or SOPS-encrypted version)
#  Do NOT commit the real .env with real secrets.
# =============================================================================

# --- NVIDIA DSX Air ----------------------------------------------------------
NV_AIR_TOKEN=                          # generate from DSX Air web UI
NV_AIR_ORG_ID=
NV_AIR_API_URL=https://air.nvidia.com/api/v2

# --- Budget guard ------------------------------------------------------------
BUDGET_DAILY_BURN_LIMIT_CH=250
BUDGET_TOTAL_HARD_LIMIT_CH=8500
BUDGET_TOTAL_SOFT_LIMIT_CH=7000
BUDGET_ALERT_EMAIL=
BUDGET_ALERT_SLACK_WEBHOOK=

# --- Redpanda ----------------------------------------------------------------
REDPANDA_BROKERS=node-event:9092
REDPANDA_SCHEMA_REGISTRY_URL=http://node-event:8081
REDPANDA_ADMIN_USER=admin
REDPANDA_ADMIN_PASSWORD=                # set me, store in SOPS
REDPANDA_SASL_MECHANISM=SCRAM-SHA-256

# --- Postgres OLTP ------------------------------------------------------------
PG_OLTP_HOST=node-cdc
PG_OLTP_PORT=5432
PG_OLTP_DB=oltp
PG_OLTP_USER=oltp
PG_OLTP_PASSWORD=                       # set me, store in SOPS

# --- Postgres metastore -------------------------------------------------------
PG_META_HOST=node-obs
PG_META_PORT=5432
PG_META_DB=metastore
PG_META_USER=metastore
PG_META_PASSWORD=                       # set me, store in SOPS

# --- MinIO --------------------------------------------------------------------
MINIO_ENDPOINT=http://node-lake:9000
MINIO_ACCESS_KEY=                       # set me
MINIO_SECRET_KEY=                       # set me
MINIO_REGION=us-east-1

# --- Iceberg ------------------------------------------------------------------
ICEBERG_CATALOG_URL=http://node-lake:8181
ICEBERG_WAREHOUSE=s3://lakehouse/warehouse/

# --- Flink --------------------------------------------------------------------
FLINK_REST_URL=http://node-stream:8081
FLINK_CHECKPOINT_DIR=s3://flink-checkpoints/

# --- ClickHouse ---------------------------------------------------------------
CLICKHOUSE_HOST=node-serve
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=                    # set me

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://node-serve:6379/0

# --- FastAPI ------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_JWT_PUBLIC_KEY_PATH=infra/secrets/jwt-public.pem
API_LOG_LEVEL=info

# --- Observability -----------------------------------------------------------
PROMETHEUS_URL=http://node-obs:9090
GRAFANA_URL=http://node-obs:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=                 # set me
LOKI_URL=http://node-obs:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://node-obs:4318

# --- Lineage ------------------------------------------------------------------
OPENLINEAGE_URL=http://node-obs:5000
OPENLINEAGE_NAMESPACE=data-platform-dsx

# --- AI / RAG -----------------------------------------------------------------
QDRANT_URL=http://node-ai:6333
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LLM_PROVIDER=anthropic                  # or openai / local
ANTHROPIC_API_KEY=                      # set me, store in SOPS
OPENAI_API_KEY=

# --- Producer defaults --------------------------------------------------------
PROD_DEFAULT_RATE=100
PROD_DEFAULT_DURATION=10m
PROD_DEFAULT_SEED=42
